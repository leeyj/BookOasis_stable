# --- BookOasis 설정 ---

# 🕒 타임존 (Docker 배포 시, 컨테이너가 UTC로 뜨는 것을 방지) | Timezone (Docker only — without this the container runs on UTC)
# 이 값을 설정하지 않으면 스캔완료시각 등 DB에 기록되는 모든 타임스탬프가 컨테이너 로컬시간(기본 UTC)
# 기준으로 저장되고, 화면에는 브라우저 로컬시간처럼 표시되어 실제 시각과 어긋나 보일 수 있습니다.
# 이 값은 여기(.env) 또는 docker-compose.yml의 bookoasis 서비스 environment: 항목 어디에 설정해도 됩니다.
# 참고: 웹 UI 설정 > 일반 > "크론 스케줄 타임존"은 이 값과 별개로, 자동 스캔 등 크론 예약 실행 시각에만
# 적용됩니다 — 두 값을 다르게 두면 "예약한 시각에 스캔이 안 돈다"는 문제가 생기니 함께 맞추세요.
#TZ=Asia/Seoul



# 메타데이터 설정 (예: 한국의 경우 aladin, 미국의 경우 google 등) - 현재는 한국의 알라딘만 지원
#METADATA_PROVIDER=aladin
#ALADIN=your_aladin_ttbkey_here

# 🌟 구글 드라이브 연동 (실험적, DEVELOP=true 전용 — "Drive에서 복사해오기"/공유 폴더 목록 수집 시 사용) | 🌟 Google Drive integration (experimental, DEVELOP=true only — used for "Copy from Drive" / share-folder listing)
# 공개 폴더 목록을 수집할 때 API Key가 없으면 HTML 스크래핑 폴백을 쓰는데, 페이지네이션이
# 없어 폴더당 항목이 많으면(체감상 50개 이상) 일부가 조용히 누락될 수 있습니다. API Key를
# 설정하면 Drive REST API로 정확하게(페이지네이션 포함) 수집합니다.
# 발급: https://console.cloud.google.com/apis/credentials 에서 "API 키" 생성 후 Drive API 활성화.
# 도커로 실행 중이라면 이 값을 바꾼 뒤 컨테이너를 재시작(docker restart)하는 것만으로는
# 반영되지 않을 수 있습니다 — env_file은 컨테이너 생성 시점에만 읽히므로 `docker compose up -d`로
# 재생성해야 합니다. `docker exec <컨테이너명> env | grep -i gdrive`로 실제 반영 여부를 확인할 수 있습니다.
#GDRIVE_API_KEY=your_google_api_key_here

# ⚠️ 메타데이터 플러그인의 subprocess/os.system 등 외부 프로세스 실행 허용 (기본: 차단)
# 기본적으로 플러그인 코드에 subprocess/os.system/os.exec*/os.spawn* 호출이 있으면 로드 자체를
# 거부합니다(정적 검사, plugins/metadata/{plugin_id}/ 안의 플러그인 작성자 코드만 대상 —
# requirements.txt로 설치된 libs/ 하위 서드파티 패키지나 BookOasis 코어의 ffmpeg/rclone 호출은
# 대상이 아님). 신뢰하는 플러그인이 정말 서브프로세스가 필요할 때만 이 값을 true로 켜세요.
# 주의: 이 검사는 정적 검사라 "작정하고 탐지를 우회하려는" 코드까지 막지는 못합니다 — 실수로
# subprocess를 쓴 평범한 플러그인을 막는 안전장치이지 샌드박스가 아닙니다. true로 켜면 허용된
# 각 건은 대시보드 등에 노출되지 않고 logs/plugin_subprocess_allowed.log 파일에만 기록됩니다.
# | ⚠️ Allow metadata plugins to spawn external processes via subprocess/os.system etc. (default: blocked)
# By default, plugin code containing subprocess/os.system/os.exec*/os.spawn* calls is refused at
# load time (a static check, scoped only to the plugin author's own code under
# plugins/metadata/{plugin_id}/ — not to third-party packages installed into libs/ via
# requirements.txt, nor to BookOasis core's own ffmpeg/rclone calls). Only enable this for a
# plugin you trust and that genuinely needs to spawn a process.
# Note: this is a static check, so it cannot catch code that deliberately tries to evade
# detection — it's a safety net against ordinary plugins that use subprocess unintentionally,
# not a sandbox. When enabled, each allowed case is logged only to
# logs/plugin_subprocess_allowed.log (never surfaced in the dashboard/API).
#ALLOW_PLUGIN_SUBPROCESS=true

# rclone은 이미지에 내장되어 있고, /app/rclone/rclone.conf로 자신의 rclone.conf를 바인드
# 마운트하면(docker-compose.yml 참조) 이 env 설정 없이도 그대로 동작합니다(최우선순위).
# 그 경로에 파일이 없을 때만 아래 env가 쓰입니다 — rclone.conf를 다른 경로에 두고 쓰는
# 경우(예: 여러 인스턴스가 서로 다른 rclone.conf를 참조) 이 값으로 경로를 직접 지정합니다.
# 위 "Drive에서 복사해오기" 관련 rclone CLI 호출(config dump/copyid/copy 등) 전체에 적용됩니다.
# rclone 자체가 이미 인식하는 표준 환경변수인 RCLONE_CONFIG를 써도 동일하게 동작합니다
# (도커에서 다른 rclone 컨테이너와 이미 이 이름으로 맞춰둔 경우 그대로 재사용 가능).
# 둘 다 설정하면 RCLONE_CONFIG_PATH가 우선합니다.
# rclone is bundled in the image, and bind-mounting your own rclone.conf to
# /app/rclone/rclone.conf (see docker-compose.yml) works without any of the env vars below
# (highest priority). The env vars below are only used when that path has no file — e.g. if
# you keep rclone.conf somewhere else (multiple instances each pointing at a different file).
# Applies to every rclone CLI call this feature makes (config dump/copyid/copy, etc).
# The standard rclone env var RCLONE_CONFIG works too (handy if your Docker setup
# already sets it for another rclone container). RCLONE_CONFIG_PATH wins if both are set.
#RCLONE_CONFIG_PATH=/path/to/your/rclone.conf
#RCLONE_CONFIG=/app/config/rclone.conf

# 데이터베이스 시스템 엔진 설정 (sqlite [기본] / mariadb 지원)
DB_ENGINE=sqlite

# MariaDB 연결 설정 (DB_ENGINE=mariadb 사용 시 설정)
#MARIADB_HOST=127.0.0.1
#MARIADB_PORT=3306
#MARIADB_USER=bookoasis
#MARIADB_PASSWORD=your_mariadb_password_here
#MARIADB_DATABASE_PREFIX=media_


# 운영 시에는 아래 값 개개인에 맞게 설정 및 유지해야 합니다. | During operation, the values ​​below must be set and maintained according to each individual.
SECRET_KEY=yoursupersecretfixedkey12345!

# 🌟 전역 요청 본문 최대 크기(MB) | 🌟 Global max request payload size (MB)
# Flask MAX_CONTENT_LENGTH (default: 100MB)
#MAX_CONTENT_LENGTH_MB=100

# 🌟 뷰어 콘솔 로깅 제어 (디버그 모드 작동 시에만 true) |  🌟 Viewer console logging control (true only when debug mode is enabled)
VIEW_LOG=false

# ZIP 로그 아카이브 보존 정책 (로그 파일별 적용, 오래된 ZIP부터 삭제)
# Maximum ZIP archives retained per log file (default: 10)
#LOG_ARCHIVE_MAX_FILES=10
# Maximum total ZIP archive size per log file in MB (default: 200)
#LOG_ARCHIVE_MAX_MB=200

# 🌟 외부 연동 웹훅 전역 보안 API 토큰 | 🌟 Global security API token for external integration webhooks
# DB settings value (`settings` table) takes precedence; this env value is fallback.
WEBHOOK_TOKEN=your_secure_api_token_here

# 🌟 Proxy Header Auth 보안 하드닝(선택) | 🌟 Proxy Header Auth hardening (optional)
# Trusted reverse proxy source IP/CIDR whitelist (comma-separated)
#PROXY_HEADER_TRUSTED_IPS=127.0.0.1,10.0.0.0/8,192.168.0.0/16
# Deny direct access without proxy headers when Proxy Header Auth is enabled (0/1)
#PROXY_HEADER_DENY_DIRECT=0

# 🌟 CSP 단계적 적용 (권장: Report-Only -> Enforce) | 🌟 CSP staged rollout (recommended: Report-Only -> Enforce)
# Global CSP toggle
#SECURITY_CSP_ENABLED=true
# Report-only mode (collect violations without blocking)
#SECURITY_CSP_REPORT_ONLY=true
# Enforce mode (actually block violating resources)
#SECURITY_CSP_ENFORCE=false
# Log CSP reports to server log
#SECURITY_CSP_LOG_REPORTS=true
# CSP report JSONL file path (default: ./logs/csp_reports.jsonl)
#SECURITY_CSP_REPORT_FILE=./logs/csp_reports.jsonl
# Max accepted CSP reports per minute (excess is suppressed)
#SECURITY_CSP_REPORT_RATE_LIMIT_PER_MIN=120
# Dedup window in seconds for identical violation fingerprints
#SECURITY_CSP_REPORT_DEDUP_WINDOW_SEC=30
# Optional: custom CSP policy override (default policy is auto-generated in core.py)
#SECURITY_CSP_POLICY=default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: ws: wss:; frame-src 'self' https:; media-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'; report-uri /api/security/csp-report

# 🌟 외부 알림(Webhook) 대상 설정 | 🌟 Outbound webhook targets
# DB settings values take precedence when configured; env values are fallback.
# Discord incoming webhook URL
#WEBHOOK_DISCORD_URL=https://discord.com/api/webhooks/...
# Slack incoming webhook URL
#WEBHOOK_SLACK_URL=https://hooks.slack.com/services/...
# Telegram option A: full URL (can include chat_id query)
#WEBHOOK_TELEGRAM_URL=https://api.telegram.org/bot<token>/sendMessage
# Telegram option B: token + chat_id
#WEBHOOK_TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#WEBHOOK_TELEGRAM_CHAT_ID=123456789
# Additional generic targets (name=url, comma-separated)
#WEBHOOK_NOTIFY_URLS=ops=https://example.com/hook,backup=https://example.net/hook
# Request timeout (seconds)
#WEBHOOK_NOTIFY_TIMEOUT=5

# Standard book event webhook endpoint(s) for community schema.
# DB settings values take precedence when configured; env values are fallback.
# Comma/newline/semicolon separated values are supported.
#WEBHOOK_EVENT_ENDPOINT=http://127.0.0.1:9000/webhook
#WEBHOOK_EVENT_ENDPOINTS=http://127.0.0.1:9000/webhook,https://example.com/webhook
# Standard event request timeout (seconds)
#WEBHOOK_EVENT_TIMEOUT=5
# Retry count for failed event delivery (0-5)
#WEBHOOK_EVENT_RETRY=2
# Optional HMAC signature secret (header: X-BookOasis-Signature)
#WEBHOOK_EVENT_SECRET=change_me

REDIS_URL=redis://127.0.0.1:6379/0
# Redis 연결 실패 시 재시도까지 대기하는 시간(초). 이 시간 동안은 재연결을 시도하지 않고
# SQLite 직접 쓰기 모드로 동작합니다 (default: 30)
#REDIS_RETRY_COOLDOWN_SEC=30