# Python Cache
__pycache__/
*.pyc

# Local Environment & Secrets
.env
.agent.md
.venv/
venv/
ENV/
deploy.py
test_deploy.py
test/
client_secret_*.json
gdrive_*.json

# Project Specific Data (DB & Cache)
db/*.db
db/*.db-wal
db/*.db-shm
db/*.db-journal
bo_relay_ss/*.db
bo_relay_ss/*.db-wal
bo_relay_ss/*.db-shm
bo_relay_ss/*.db-journal
bo_relay_ss/.venv/
cache/*
